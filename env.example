# Database Configuration
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database_name
DB_URL=postgres://user:password@localhost:5432/hauler_db

# JWT Secret Token
# Used for signing and verifying JWT tokens
# IMPORTANT: Use a strong, random secret in production
# Generate one with: openssl rand -base64 32
SECRET_TOKEN=your-secret-key-change-in-production

# Resend Email Service Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Resend From Email Address
# Must be a verified domain in your Resend account
# Format: name@yourdomain.com
# If not set, defaults to onboarding@resend.dev (for testing only)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Super Admin Configuration (Optional)
# These are used when creating the default super admin account
# If not provided, defaults will be used:
#   Email: admin@hauler.com
#   Password: Admin@123
SUPER_ADMIN_EMAIL=admin@hauler.com
SUPER_ADMIN_PASSWORD=Admin@123

